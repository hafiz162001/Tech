<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">
    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="eterna-platform-api"/>
    <springProperty scope="context" name="env" source="spring.profiles.active" defaultValue="dev"/>

    <!-- Standard Local Console Appender for readable local development -->
    <appender name="CONSOLE_PRETTY" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %highlight(%-5level) %cyan(%logger{36}) [reqId=%X{requestId:-none} user=%X{userId:-anon}] - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Datadog Structured JSON Console Appender (Tailored by Datadog Agent) -->
    <appender name="DATADOG_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp>
                    <timeZone>UTC</timeZone>
                    <fieldName>timestamp</fieldName>
                </timestamp>
                <logLevel>
                    <fieldName>level</fieldName>
                </logLevel>
                <loggerName>
                    <fieldName>logger</fieldName>
                </loggerName>
                <threadName>
                    <fieldName>thread</fieldName>
                </threadName>
                <message>
                    <fieldName>message</fieldName>
                </message>
                <stackTrace>
                    <fieldName>error.stack</fieldName>
                </stackTrace>
                <!-- Captures SLF4J MDC attributes (e.g. requestId, userId, and Datadog dd.trace_id, dd.span_id) -->
                <mdc/>
                <pattern>
                    <pattern>
                        {
                            "service": "${appName}",
                            "env": "${env}",
                            "version": "1.0.0"
                        }
                    </pattern>
                </pattern>
            </providers>
        </encoder>
    </appender>

    <!-- Profile configuration: In production/cloud use Datadog JSON, in dev use readable or JSON -->
    <springProfile name="dev">
        <root level="INFO">
            <appender-ref ref="CONSOLE_PRETTY"/>
        </root>
    </springProfile>

    <springProfile name="!dev">
        <root level="INFO">
            <appender-ref ref="DATADOG_JSON"/>
        </root>
    </springProfile>
</configuration>
